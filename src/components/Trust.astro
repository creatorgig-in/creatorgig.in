---
import Icon from './Icon.astro';

const pillars = [
  { icon: 'shield-check', title: 'Payments held safely', desc: 'Money is locked in when the deal is agreed and released only when the work is delivered.' },
  { icon: 'badge-check', title: 'Verified on both sides', desc: 'Creators connect real accounts. Brands are reviewed before they post briefs.' },
  { icon: 'lock', title: 'Private by default', desc: 'End-to-end encrypted chat keeps every negotiation between you and them.' },
  { icon: 'scale', title: 'Fair dispute resolution', desc: 'If a deal goes sideways, our team reviews the evidence and makes the call.' },
] as const;

const disputeSteps = [
  { title: 'Dispute raised', desc: 'Either side flags the deal. Payment stays on hold.', state: 'done' },
  { title: 'Both sides share proof', desc: 'Brief, chat history and deliverables are attached.', state: 'done' },
  { title: 'creatorgig team reviews', desc: 'A real person checks the facts against the agreed brief.', state: 'active' },
  { title: 'Resolved', desc: 'Payment is released, split or refunded.', state: 'pending' },
] as const;
---

<section id="trust" class="section relative overflow-hidden">
  <div class="container-x grid items-center gap-12 lg:grid-cols-2">
    <div data-reveal>
      <span class="text-sm font-semibold text-gradient">Trust &amp; safety</span>
      <h2 class="mt-3 text-[clamp(2rem,5vw,3.25rem)]">
        Every deal has <span class="text-gradient">backup.</span>
      </h2>
      <p class="mt-4 max-w-md text-lg text-muted">
        Creators get paid for the work they deliver. Brands get the work they paid for. When something goes wrong, real people step in.
      </p>

      <ul class="mt-8 grid gap-5 sm:grid-cols-2" data-stagger>
        {
          pillars.map((p) => (
            <li class="flex gap-4" data-stagger-item>
              <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-grad-main text-white">
                <Icon name={p.icon} size={18} />
              </span>
              <div>
                <h3 class="font-display text-lg font-bold tracking-tight">{p.title}</h3>
                <p class="mt-1 text-sm text-muted">{p.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="mt-8 inline-flex items-center gap-2 text-sm text-muted">
        <Icon name="life-buoy" size={16} class="text-hotpink" />
        Stuck on anything? Our support team is one message away.
      </p>
    </div>

    <div data-reveal aria-hidden="true">
      <div class="rounded-2xl border border-border bg-card p-5 shadow-[0_30px_70px_-30px_rgba(0,0,0,0.8)]">
        <div class="flex items-center gap-3 rounded-xl border border-border bg-surface p-3">
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-grad-cool text-white">
            <Icon name="scale" size={16} />
          </span>
          <div class="min-w-0 leading-tight">
            <p class="text-sm font-semibold">Dispute · Reel + Story</p>
            <p class="text-xs text-muted">₹12,000 on hold</p>
          </div>
          <span class="ml-auto shrink-0 rounded-full bg-grad-warm px-2.5 py-0.5 text-[10px] font-bold text-white">In review</span>
        </div>

        <ol class="mt-5 space-y-0">
          {
            disputeSteps.map((s, i) => (
              <li class="relative flex gap-3 pb-5 last:pb-0">
                {i < disputeSteps.length - 1 && (
                  <span
                    class={`absolute left-[0.8rem] top-7 bottom-0 w-px ${s.state === 'done' ? 'bg-hotpink' : 'bg-border'}`}
                  />
                )}
                <span
                  class={`relative grid size-[1.65rem] shrink-0 place-items-center rounded-full ${
                    s.state === 'done'
                      ? 'bg-grad-main text-white'
                      : s.state === 'active'
                        ? 'step-active border-2 border-hotpink bg-card'
                        : 'border border-border bg-surface'
                  }`}
                >
                  {s.state === 'done' && <Icon name="check" size={13} strokeWidth={3} />}
                  {s.state === 'active' && <span class="size-2 rounded-full bg-hotpink" />}
                </span>
                <div class="leading-tight">
                  <p class={`text-sm font-semibold ${s.state === 'pending' ? 'text-muted' : ''}`}>{s.title}</p>
                  <p class="mt-1 text-xs text-muted">{s.desc}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="mt-5 flex items-center gap-2 rounded-xl border border-border bg-surface p-3 text-xs text-muted">
          <Icon name="shield-check" size={14} class="shrink-0 text-hotpink" />
          Funds never move until the dispute is settled.
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .step-active {
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-hotpink) 20%, transparent);
  }
</style>
