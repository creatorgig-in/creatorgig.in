---
import Icon from './Icon.astro';
import { NAV_LINKS } from '../consts';

const influencersHref = NAV_LINKS.find((l) => l.label === 'Find influencers')!.href;
const brandsHref = NAV_LINKS.find((l) => l.label === 'Our brands')!.href;

const cards = [
  {
    icon: 'search',
    eyebrow: 'For business',
    title: 'Find influencers',
    desc: 'Search verified creators by platform, audience size and niche — then reach out directly.',
    cta: 'Search influencers',
    href: influencersHref,
  },
  {
    icon: 'building',
    eyebrow: 'For creators',
    title: 'Our brands',
    desc: 'Browse brands actively looking for creators and see what they’re offering.',
    cta: 'Browse brands',
    href: brandsHref,
  },
] as const;
---

<section id="discover" class="section relative overflow-hidden">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <span class="text-sm font-semibold text-gradient">Discover</span>
      <h2 class="mt-3 text-[clamp(2rem,5vw,3.25rem)]">
        Start with a <span class="text-gradient">search.</span>
      </h2>
      <p class="mt-4 text-lg text-muted">
        Everything starts with finding the right match — search creators or brands in our app.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2" data-stagger>
      {
        cards.map((c) => (
          <a
            href={c.href}
            class="group flex flex-col rounded-2xl border border-border bg-card p-7 transition-colors hover:border-muted"
            data-stagger-item
          >
            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-grad-main text-white">
              <Icon name={c.icon} size={20} />
            </span>
            <span class="mt-5 text-sm font-semibold text-gradient">{c.eyebrow}</span>
            <h3 class="mt-1 font-display text-2xl font-bold tracking-tight">{c.title}</h3>
            <p class="mt-2 text-muted">{c.desc}</p>
            <span class="mt-6 inline-flex items-center gap-2 font-semibold text-ghost">
              {c.cta}
              <Icon name="arrow-up-right" size={18} class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
